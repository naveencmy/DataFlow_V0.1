# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL 15)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow_hrms?schema=public"

# Redis Connection (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=dayflow_super_secret_access_jwt_key_2026_production_grade_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dayflow_super_secret_refresh_jwt_key_2026_production_grade_32chars
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Brevo (Sendinblue) Transactional SMTP Configuration
# ---------------------------------------------------------------------------
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=naveenatdevine@gmail.com
SMTP_FROM_NAME="HR"

# AWS S3 / Object Storage (Optional for MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dayflow-documents
AWS_S3_ENDPOINT=
