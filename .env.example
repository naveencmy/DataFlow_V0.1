# Root .env.example - Dayflow HRMS Enterprise Stack
# ==============================================================================
# Cloud Platform Configuration (AWS / GCP)
# ==============================================================================
AWS_REGION=us-east-1
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=dayflow-hrms-repo

# ==============================================================================
# Backend Configuration
# ==============================================================================
PORT=8080
NODE_ENV=production
SERVICE_VERSION=1.0.0

# PostgreSQL Database Connection URL (RDS / Cloud SQL / Local)
DATABASE_URL=postgresql://dayflow_admin:<password>@localhost:5432/dayflow_hrms?schema=public

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Security Secrets
JWT_SECRET=super_secret_jwt_key_dayflow_enter_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
FRONTEND_URL=https://app.dayflow.io

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_BASE_URL=https://api.dayflow.io/api
